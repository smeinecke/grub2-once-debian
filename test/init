#!/bin/busybox sh
# Guest-side test driver, runs as PID 1 inside the initramfs.
# Prints "###"-prefixed markers to the serial console; the host
# driver asserts on them.

/bin/busybox mkdir -p /dev /proc /sys /boot /tmp /bin /sbin
/bin/busybox mknod /dev/console c 5 1 2>/dev/null
/bin/busybox mknod /dev/null c 1 3 2>/dev/null
exec </dev/console >/dev/console 2>&1
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

/bin/busybox --install -s /bin
/bin/busybox --install -s /sbin

mount -t proc proc /proc
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null

# Load whatever kernel modules the host decided we need.
for m in $(cat /lib/modules/modlist 2>/dev/null); do
    insmod /lib/modules/"$m".ko 2>/dev/null
done

# block device may appear asynchronously (esp. under TCG emulation)
i=0
while [ ! -b /dev/vda1 ] && [ ! -b /dev/sda1 ] && [ $i -lt 10 ]; do
    sleep 1; i=$((i+1))
done

# Mount the real boot partition (the one GRUB reads).
mount -o rw /dev/vda1 /boot 2>/dev/null || mount -o rw /dev/sda1 /boot || {
    echo "### FAIL cannot mount boot partition"; poweroff -f; }

stage=0
[ -f /boot/.stage ] && read stage < /boot/.stage
echo "### STAGE=$stage"
echo "### CMDLINE $(cat /proc/cmdline)"

case "$stage" in
0)
    echo "### LIST-BEGIN"
    /usr/sbin/grub-once --list
    echo "### LIST-END"
    /usr/sbin/grub-once 1 && echo "### SELECT-OK"
    echo "### GRUBENV-BEGIN"
    /usr/bin/grub-editenv /boot/grub/grubenv list
    echo "### GRUBENV-END"
    echo 1 > /boot/.stage
    ;;
1)
    echo 2 > /boot/.stage
    ;;
*)
    echo "### DONE"
    ;;
esac

sync
sleep 1
if [ "$stage" -lt 2 ]; then
    reboot -f
else
    poweroff -f
fi
